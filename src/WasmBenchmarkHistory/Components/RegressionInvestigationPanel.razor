<section class="investigation-panel" aria-labelledby="@_titleId">
    <div class="investigation-heading">
        <div>
            <h2 id="@_titleId">A/B interval comparison</h2>
            <p>
                Each selected benchmark and runtime is compared independently using its nearest raw samples
                to the shared A and B timestamps. Sample dates and offsets are shown; values are never
                compared across different benchmarks or runtimes.
            </p>
        </div>
        @if (BaselinePin is not null || ComparisonPin is not null)
        {
            <button type="button" class="clear-all" @onclick="ClearAllAsync">Clear A/B interval</button>
        }
    </div>

    @if (BaselinePin is null || ComparisonPin is null)
    {
        <div class="investigation-empty">
            <strong>@(BaselinePin is null ? "Choose baseline A." : "Choose comparison B.")</strong>
            <span>Pin a timestamp in any chart. A and B can come from different benchmarks and runtimes.</span>
        </div>
    }
    else
    {
        <div class="interval-dates">
            <span>
                <strong>A</strong> @FormatTimestamp(BaselinePin.Identity.Timestamp)
                <button type="button" @onclick="() => ClearPinAsync(InvestigationPinSlot.BaselineA)">Clear A</button>
            </span>
            <span>
                <strong>B</strong> @FormatTimestamp(ComparisonPin.Identity.Timestamp)
                <button type="button" @onclick="() => ClearPinAsync(InvestigationPinSlot.ComparisonB)">Clear B</button>
            </span>
            @if (BaselinePin.Identity.Timestamp == ComparisonPin.Identity.Timestamp)
            {
                <span class="interval-note">A and B are the same timestamp; choose distinct dates to compare a change.</span>
            }
        </div>

        <div class="summary-switch" role="group" aria-label="Interval comparison method">
            <button type="button"
                    class="@(!UseRobustSummary ? "active" : null)"
                    aria-pressed="@(!UseRobustSummary ? "true" : "false")"
                    @onclick="() => ChangeSummaryAsync(false)">
                Nearest raw samples
            </button>
            <button type="button"
                    class="@(UseRobustSummary ? "active" : null)"
                    aria-pressed="@(UseRobustSummary ? "true" : "false")"
                    @onclick="() => ChangeSummaryAsync(true)">
                Robust 7-sample windows
            </button>
        </div>
        @if (UseRobustSummary)
        {
            <p class="method-note">
                Each endpoint uses up to seven observations around its nearest sample. Changes are computed
                within a single benchmark/runtime row, older to newer; no significance or p-value claim is made.
            </p>
        }

        <div class="interval-table-scroll">
            <table class="interval-table">
                <thead>
                    <tr>
                        <th scope="col">Benchmark</th>
                        <th scope="col">Runtime</th>
                        <th scope="col">A sample</th>
                        <th scope="col">B sample</th>
                        <th scope="col">Change, older → newer</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr @key="(row.Benchmark, row.Run.Id)">
                            <th scope="row" title="@row.Benchmark">@row.Benchmark</th>
                            <td>@row.Run.DisplayName</td>
                            @if (row.MissingHistory)
                            {
                                <td colspan="3" class="unavailable-sample">No history available for this benchmark/runtime.</td>
                            }
                            else
                            {
                                <td>@SampleDetails(row.AtA!)</td>
                                <td>@SampleDetails(row.AtB!)</td>
                                <td>
                                    @if (row.Analysis is null)
                                    {
                                        <span class="unavailable-sample">Unavailable until both endpoints have a nearby sample.</span>
                                    }
                                    else
                                    {
                                        @ChangeDetails(row.Analysis)
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="tolerance-note">
            A sample must be within three median observation intervals (at least 7 days, at most 30 days)
            of its target. Ties are marked ambiguous rather than chosen arbitrarily.
        </p>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<BenchmarkHistory> Histories { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> Benchmarks { get; set; } = [];

    [Parameter]
    public IReadOnlyCollection<string> RunIds { get; set; } = [];

    [Parameter]
    public InvestigationPin? BaselinePin { get; set; }

    [Parameter]
    public InvestigationPin? ComparisonPin { get; set; }

    [Parameter]
    public bool UseRobustSummary { get; set; }

    [Parameter]
    public EventCallback<bool> UseRobustSummaryChanged { get; set; }

    [Parameter]
    public EventCallback<InvestigationPinSlot> PinCleared { get; set; }

    [Parameter]
    public EventCallback ClearAll { get; set; }

    private readonly string _titleId = $"interval-comparison-{Guid.NewGuid():N}";
    private IReadOnlyList<IntervalRow> _rows = [];

    protected override void OnParametersSet()
    {
        if (BaselinePin is null || ComparisonPin is null)
        {
            _rows = [];
            return;
        }

        var rows = new List<IntervalRow>();
        foreach (var benchmark in Benchmarks)
        {
            foreach (var runId in RunIds)
            {
                var run = KnownRunConfigurations.All.FirstOrDefault(candidate => candidate.Id == runId);
                if (run is null)
                {
                    continue;
                }

                var history = Histories.FirstOrDefault(candidate =>
                    candidate.Benchmark == benchmark && candidate.Run.Id == runId);
                if (history is null)
                {
                    rows.Add(new IntervalRow(benchmark, run, true, null, null, null));
                    continue;
                }

                var comparison = BenchmarkIntervalComparisonCalculator.Analyze(
                    history,
                    BaselinePin.Identity.Timestamp,
                    ComparisonPin.Identity.Timestamp);
                rows.Add(new IntervalRow(
                    benchmark,
                    run,
                    false,
                    comparison.AtA,
                    comparison.AtB,
                    comparison.Analysis));
            }
        }

        _rows = rows;
    }

    private RenderFragment SampleDetails(IntervalSample sample) => @<div class="interval-sample">
        @if (sample.Observation is null)
        {
            <strong>@UnavailableText(sample)</strong>
            @if (sample.Status == IntervalSampleStatus.TooDistant)
            {
                <small>@FormatOffset(sample.Offset) away · limit @FormatOffset(sample.MaximumOffset)</small>
            }
        }
        else
        {
            var unit = DurationFormatter.SelectUnit(sample.Observation.Value);
            <strong>@DurationFormatter.Format(sample.Observation.Value, unit)</strong>
            @if (sample.Observation.Error is not null)
            {
                <small>± @DurationFormatter.Format(sample.Observation.Error.Value, unit)</small>
            }
            <small>@FormatTimestamp(sample.Observation.Timestamp)</small>
            <small>@FormatOffset(sample.Offset) from target · @ShortSha(sample.Observation.RuntimeSha)</small>
        }
    </div>;

    private RenderFragment ChangeDetails(RegressionInvestigationResult analysis) => @<div class="interval-change">
        @{
            var absoluteDelta = UseRobustSummary
                ? analysis.Windows.AbsoluteDelta
                : analysis.Points.AbsoluteDelta;
            var percentChange = UseRobustSummary
                ? analysis.Windows.PercentChange
                : analysis.Points.PercentChange;
            var olderValue = UseRobustSummary
                ? analysis.Windows.Older.Median
                : analysis.Points.Older.Value;
            var unit = DurationFormatter.SelectUnit(olderValue, olderValue + absoluteDelta);
            var olderSlot = analysis.Points.OlderSlot;
            var olderEndpoint = olderSlot == InvestigationPinSlot.BaselineA
                ? BaselinePin!
                : ComparisonPin!;
            var newerEndpoint = olderSlot == InvestigationPinSlot.BaselineA
                ? ComparisonPin!
                : BaselinePin!;
            var runtimeLink = GitHubCompareLinkBuilder.Runtime(
                analysis.Points.Older.RuntimeSha,
                analysis.Points.Newer.RuntimeSha);
            var performanceLink = GitHubCompareLinkBuilder.Performance(
                analysis.Points.Older.PerformanceSha,
                analysis.Points.Newer.PerformanceSha);
        }
        <strong>@FormatSigned(absoluteDelta, unit)</strong>
        @if (percentChange is null)
        {
            <small>percent undefined (older value is zero)</small>
        }
        else
        {
            <small>@percentChange.Value.ToString("+0.00;-0.00;0.00", CultureInfo.InvariantCulture)%</small>
        }
        @if (UseRobustSummary)
        {
            <small>median @DurationFormatter.Format(analysis.Windows.Older.Median, unit) → @DurationFormatter.Format(analysis.Windows.Newer.Median, unit)</small>
            <small>window samples n=@analysis.Windows.Older.Count → n=@analysis.Windows.Newer.Count</small>
        }
        else
        {
            <small>@SlotLabel(olderSlot) @FormatTimestamp(olderEndpoint.Identity.Timestamp) → @SlotLabel(Opposite(olderSlot)) @FormatTimestamp(newerEndpoint.Identity.Timestamp)</small>
        }
        <div class="interval-links">
            @if (runtimeLink is not null)
            {
                <a href="@runtimeLink" target="_blank" rel="noopener noreferrer">runtime ↗</a>
            }
            @if (performanceLink is not null)
            {
                <a href="@performanceLink" target="_blank" rel="noopener noreferrer">performance ↗</a>
            }
        </div>
    </div>;

    private static string UnavailableText(IntervalSample sample) => sample.Status switch
    {
        IntervalSampleStatus.NoObservations => "No observations",
        IntervalSampleStatus.TooDistant => "Nearest sample is too far away",
        IntervalSampleStatus.Ambiguous => "Equidistant samples; endpoint is ambiguous",
        _ => "Sample unavailable"
    };

    private static string FormatTimestamp(DateTime timestamp) =>
        timestamp.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);

    private static string FormatOffset(TimeSpan offset) =>
        offset.TotalDays >= 1
            ? $"{offset.TotalDays:0.#}d"
            : offset.TotalHours >= 1
                ? $"{(int)offset.TotalHours}h {offset.Minutes}m"
                : $"{(int)Math.Ceiling(offset.TotalMinutes)}m";

    private static string FormatSigned(double value, DurationUnit unit) =>
        (value > 0 ? "+" : "") + DurationFormatter.Format(value, unit);

    private static string ShortSha(string sha) => sha.Length <= 10 ? sha : sha[..10];

    private static InvestigationPinSlot Opposite(InvestigationPinSlot slot) =>
        slot == InvestigationPinSlot.BaselineA
            ? InvestigationPinSlot.ComparisonB
            : InvestigationPinSlot.BaselineA;

    private static string SlotLabel(InvestigationPinSlot slot) =>
        slot == InvestigationPinSlot.BaselineA ? "A" : "B";

    private Task ChangeSummaryAsync(bool robust) =>
        UseRobustSummaryChanged.InvokeAsync(robust);

    private Task ClearPinAsync(InvestigationPinSlot slot) =>
        PinCleared.InvokeAsync(slot);

    private Task ClearAllAsync() => ClearAll.InvokeAsync();

    private sealed record IntervalRow(
        string Benchmark,
        RunConfiguration Run,
        bool MissingHistory,
        IntervalSample? AtA,
        IntervalSample? AtB,
        RegressionInvestigationResult? Analysis);
}
