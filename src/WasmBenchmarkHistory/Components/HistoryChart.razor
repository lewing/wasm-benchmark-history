@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="chart-shell">
    <div class="chart-toolbar">
        <fieldset>
            <legend>Time range</legend>
            @foreach (var option in RangeOptions)
            {
                <button type="button"
                        class="@(TimeRange.Kind == option.Range.Kind ? "active" : null)"
                        aria-pressed="@(TimeRange.Kind == option.Range.Kind)"
                        @onclick="() => ChangeRangeAsync(option.Range)">
                    @option.Label
                </button>
            }
            <button type="button"
                    class="reset-range"
                    disabled="@(TimeRange.Kind == HistoryRangeKind.All)"
                    @onclick="ResetRangeAsync">
                Reset
            </button>
        </fieldset>
        <span class="zoom-help">
            @(TimeRange.Kind == HistoryRangeKind.Custom
                ? $"{TimeRange.Start:yyyy-MM-dd} – {TimeRange.End:yyyy-MM-dd}"
                : "Drag across the plot to zoom")
        </span>
    </div>

    @if (Series.Count == 0)
    {
        <div class="chart-empty">
            <strong>@(Normalized ? "No strict matched points in this range." : "No observations in this range.")</strong>
            <span>Choose a wider time range or reset the chart.</span>
        </div>
    }
    else
    {
        <div class="legend">
            @foreach (var series in Series)
            {
                <span>
                    <i style="background:@series.History.Run.Color"></i>
                    <strong>@series.History.Run.DisplayName</strong>
                    <small>@series.Points.Count.ToString("N0") visible points</small>
                </span>
            }
        </div>

        <div class="plot-area">
            <div class="svg-wrap">
                <svg @ref="_chartElement"
                     viewBox="0 0 1000 430"
                     preserveAspectRatio="none"
                     role="img"
                     aria-label="Historical benchmark line chart"
                     aria-describedby="chart-hover-instructions">
                    <rect class="plot-background" x="@PlotLeft" y="@PlotTop" width="@PlotWidth" height="@PlotHeight" rx="8" />

                    @for (var tick = 0; tick <= 4; tick++)
                    {
                        var y = PlotTop + PlotHeight * tick / 4d;
                        <line class="grid-line" x1="@PlotLeft" y1="@y" x2="@(PlotLeft + PlotWidth)" y2="@y" />
                        <svg:text class="axis-label" x="@(PlotLeft - 12)" y="@(y + 4)" text-anchor="end">
                            @FormatAxisValue(MaxY - (MaxY - MinY) * tick / 4d)
                        </svg:text>
                    }

                    @for (var tick = 0; tick <= 4; tick++)
                    {
                        var x = PlotLeft + PlotWidth * tick / 4d;
                        <line class="grid-line vertical" x1="@x" y1="@PlotTop" x2="@x" y2="@(PlotTop + PlotHeight)" />
                        <svg:text class="axis-label" x="@x" y="@(PlotTop + PlotHeight + 28)" text-anchor="middle">
                            @FormatDate(MinTicks + (long)((MaxTicks - MinTicks) * tick / 4d))
                        </svg:text>
                    }

                    @foreach (var series in Series)
                    {
                        <polyline class="series-line"
                                  points="@Polyline(series.Points)"
                                  stroke="@series.History.Run.Color" />

                        @foreach (var point in SamplePoints(series.Points))
                        {
                            <circle class="series-point"
                                    cx="@ScaleX(point.Timestamp.Ticks)"
                                    cy="@ScaleY(point.Value)"
                                    r="3.2"
                                    fill="@series.History.Run.Color" />
                        }
                    }

                    @foreach (var marker in VisiblePinMarkers)
                    {
                        var markerX = ScaleX(marker.Pin.Identity.Timestamp.Ticks);
                        <line class="pin-line @marker.CssClass"
                              x1="@markerX"
                              y1="@PlotTop"
                              x2="@markerX"
                              y2="@(PlotTop + PlotHeight)" />
                        <circle class="pin-badge @marker.CssClass"
                                cx="@markerX"
                                cy="@(PlotTop + (marker.Slot == InvestigationPinSlot.BaselineA ? 13 : 34))"
                                r="11" />
                        <svg:text class="pin-label"
                                  x="@markerX"
                                  y="@(PlotTop + (marker.Slot == InvestigationPinSlot.BaselineA ? 17 : 38))"
                                  text-anchor="middle">
                            @(marker.Slot == InvestigationPinSlot.BaselineA ? "A" : "B")
                        </svg:text>
                    }

                    @if (_hover is not null)
                    {
                        <line class="hover-crosshair"
                              x1="@ScaleX(_hover.Timestamp.Ticks)"
                              y1="@PlotTop"
                              x2="@ScaleX(_hover.Timestamp.Ticks)"
                              y2="@(PlotTop + PlotHeight)" />
                        @foreach (var point in _hover.Points)
                        {
                            <circle class="hover-point-halo"
                                    cx="@ScaleX(point.Observation.Timestamp.Ticks)"
                                    cy="@ScaleY(point.DisplayValue)"
                                    r="8"
                                    fill="@point.History.Run.Color" />
                            <circle class="hover-point"
                                    cx="@ScaleX(point.Observation.Timestamp.Ticks)"
                                    cy="@ScaleY(point.DisplayValue)"
                                    r="4.5"
                                    fill="@point.History.Run.Color" />
                        }
                    }

                    <rect class="zoom-selection"
                          x="@PlotLeft"
                          y="@PlotTop"
                          width="0"
                          height="@PlotHeight" />

                    @foreach (var region in _hitRegions)
                    {
                        <rect class="interaction-band"
                              @key="region.TimelineIndex"
                              x="@region.X"
                              y="@PlotTop"
                              width="@region.Width"
                              height="@PlotHeight"
                              @onpointerenter="() => SelectTimeline(region.TimelineIndex)"
                              @onclick="() => SelectTimeline(region.TimelineIndex)" />
                    }
                </svg>
            </div>

            <input class="keyboard-scrubber"
                   type="range"
                   min="0"
                   max="@Math.Max(0, _hoverIndex.Timestamps.Count - 1)"
                   step="1"
                   value="@(_hover?.TimelineIndex ?? Math.Max(0, _hoverIndex.Timestamps.Count - 1))"
                   aria-label="Chart timestamp"
                   aria-valuetext="@KeyboardValueText"
                   aria-describedby="@(_hover is null ? "chart-hover-instructions" : "chart-hover-instructions chart-hover-card")"
                   @onfocus="OnScrubberFocus"
                   @onblur="OnScrubberBlur"
                   @oninput="OnScrubberInput" />

            @if (_hover is not null)
            {
                <aside id="chart-hover-card"
                       class="hover-card @(_hoverCardPercent > 63 ? "flip" : null)"
                       style="left:@(_hoverCardPercent.ToString("0.##", CultureInfo.InvariantCulture))%"
                       aria-label="Selected chart observation details">
                    <header>
                        <div aria-live="@(_hasKeyboardFocus ? "polite" : "off")">
                            <span>@(_hover.HasStrictComparison ? "STRICT BUILD MATCH" : "NEAREST SAMPLES")</span>
                            <strong>@_hover.Timestamp.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</strong>
                        </div>
                        <button type="button" class="close-card" aria-label="Close observation details" @onclick="ClearHover">×</button>
                    </header>

                    <div class="hover-runs">
                        @foreach (var point in _hover.Points)
                        {
                            var identity = ObservationIdentity.From(point.Observation);
                            <section>
                                <div class="hover-run-heading">
                                    <i style="background:@point.History.Run.Color"></i>
                                    <strong>@point.History.Run.DisplayName</strong>
                                    @if (!point.IsExactTimestamp)
                                    {
                                        <small>nearest @point.Observation.Timestamp.ToString("MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</small>
                                    }
                                </div>
                                <div class="hover-measure">
                                    <span>Value</span>
                                    <strong>@FormatValue(point.Observation.Value)@FormatError(point.Observation.Error)</strong>
                                    @if (point.StrictRatio is not null)
                                    {
                                        <em>@point.StrictRatio.Value.ToString("0.000×", CultureInfo.InvariantCulture)</em>
                                    }
                                </div>
                                <dl>
                                    <div>
                                        <dt>runtime</dt>
                                        <dd><code title="@point.Observation.RuntimeSha" aria-label="runtime SHA @point.Observation.RuntimeSha">@ShortSha(point.Observation.RuntimeSha)</code></dd>
                                    </div>
                                    <div>
                                        <dt>performance</dt>
                                        <dd><code title="@point.Observation.PerformanceSha" aria-label="performance repository SHA @point.Observation.PerformanceSha">@ShortSha(point.Observation.PerformanceSha)</code></dd>
                                    </div>
                                    <div>
                                        <dt>trace/build</dt>
                                        <dd title="@point.Observation.TraceName">@(point.Observation.TraceName ?? "not reported")</dd>
                                    </div>
                                </dl>
                                <div class="pin-actions" aria-label="Regression investigation pins">
                                    <button type="button"
                                            class="pin-a"
                                            disabled="@(BaselinePin?.RunId == point.History.Run.Id && BaselinePin.Identity == identity)"
                                            @onclick="() => RequestPinAsync(InvestigationPinSlot.BaselineA, point)">
                                        @(BaselinePin?.RunId == point.History.Run.Id && BaselinePin.Identity == identity ? "Pinned as A" : "Set baseline A")
                                    </button>
                                    <button type="button"
                                            class="pin-b"
                                            disabled="@(ComparisonPin?.RunId == point.History.Run.Id && ComparisonPin.Identity == identity)"
                                            @onclick="() => RequestPinAsync(InvestigationPinSlot.ComparisonB, point)">
                                        @(ComparisonPin?.RunId == point.History.Run.Id && ComparisonPin.Identity == identity ? "Pinned as B" : "Set comparison B")
                                    </button>
                                </div>
                            </section>
                        }
                    </div>
                </aside>
            }
        </div>

        <div class="chart-caption">
            <span>@(Normalized ? "Ratio to the first selected run on strict matches" : "Raw reported primary-trace values")</span>
            <span id="chart-hover-instructions">Hover the plot or focus it and use ←/→, Home, and End</span>
        </div>
    }
</div>

@code {
    private const double PlotLeft = 86;
    private const double PlotTop = 24;
    private const double PlotWidth = 884;
    private const double PlotHeight = 340;

    private static readonly IReadOnlyList<RangeOption> RangeOptions =
    [
        new("30d", HistoryTimeRange.ThirtyDays),
        new("90d", HistoryTimeRange.NinetyDays),
        new("1y", HistoryTimeRange.OneYear),
        new("All", HistoryTimeRange.All)
    ];

    [Parameter, EditorRequired]
    public IReadOnlyList<BenchmarkHistory> Histories { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<MatchedComparison> Matches { get; set; } = [];

    [Parameter]
    public bool Normalized { get; set; }

    [Parameter]
    public HistoryTimeRange TimeRange { get; set; } = HistoryTimeRange.All;

    [Parameter]
    public EventCallback<HistoryTimeRange> TimeRangeChanged { get; set; }

    [Parameter]
    public InvestigationPin? BaselinePin { get; set; }

    [Parameter]
    public InvestigationPin? ComparisonPin { get; set; }

    [Parameter]
    public EventCallback<InvestigationPinRequest> PinRequested { get; set; }

    private ElementReference _chartElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _dragHandle;
    private DotNetObjectReference<HistoryChart>? _selfReference;
    private IReadOnlyList<BenchmarkHistory> _visibleHistories = [];
    private IReadOnlyList<MatchedComparison> _visibleMatches = [];
    private IReadOnlyList<ChartSeries> _series = [];
    private IReadOnlyList<HitRegion> _hitRegions = [];
    private ChartHoverIndex _hoverIndex = new([], [], false);
    private ChartHoverSelection? _hover;
    private long _minTicks;
    private long _maxTicks;
    private double _minY;
    private double _maxY;
    private DateTime _availableMinimum;
    private DateTime _availableMaximum;
    private bool _hasKeyboardFocus;
    private bool _needsDragInitialization;

    private IReadOnlyList<ChartSeries> Series => _series;

    private IEnumerable<PinMarker> VisiblePinMarkers
    {
        get
        {
            if (BaselinePin is not null && IsVisible(BaselinePin.Identity.Timestamp))
            {
                yield return new PinMarker(
                    InvestigationPinSlot.BaselineA,
                    BaselinePin,
                    "pin-a");
            }

            if (ComparisonPin is not null && IsVisible(ComparisonPin.Identity.Timestamp))
            {
                yield return new PinMarker(
                    InvestigationPinSlot.ComparisonB,
                    ComparisonPin,
                    "pin-b");
            }
        }
    }

    private double _hoverCardPercent =>
        _hover is null
            ? 0
            : ScaleX(_hover.Timestamp.Ticks) / 1000d * 100d;

    private string KeyboardValueText =>
        (_hover?.Timestamp ?? _hoverIndex.Timestamps.LastOrDefault())
            .ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);

    protected override void OnParametersSet()
    {
        var allTimestamps = Histories
            .SelectMany(history => history.Observations)
            .Select(observation => observation.Timestamp)
            .ToArray();
        if (allTimestamps.Length == 0)
        {
            _visibleHistories = [];
            _visibleMatches = [];
            _series = [];
            return;
        }

        _availableMinimum = allTimestamps.Min();
        _availableMaximum = allTimestamps.Max();
        var visibleRange = TimeRange.Resolve(_availableMinimum, _availableMaximum);
        _visibleHistories = Histories
            .Select(history => history with
            {
                Observations = history.Observations
                    .Where(observation =>
                        observation.Timestamp >= visibleRange.Start
                        && observation.Timestamp <= visibleRange.End)
                    .ToArray()
            })
            .ToArray();
        _visibleMatches = Matches
            .Where(match =>
                match.Key.Timestamp >= visibleRange.Start
                && match.Key.Timestamp <= visibleRange.End)
            .ToArray();
        _hoverIndex = new ChartHoverIndex(_visibleHistories, _visibleMatches, Normalized);
        _hover = null;
        _series = BuildSeries();
        if (_series.Count == 0)
        {
            return;
        }

        var points = _series.SelectMany(series => series.Points).ToArray();
        _minTicks = points.Min(point => point.Timestamp.Ticks);
        _maxTicks = points.Max(point => point.Timestamp.Ticks);
        if (_maxTicks == _minTicks)
        {
            _maxTicks += TimeSpan.TicksPerDay;
        }

        var rawMin = points.Min(point => point.Value);
        var rawMax = points.Max(point => point.Value);
        var padding = rawMax == rawMin
            ? Math.Max(Math.Abs(rawMin) * .05, .05)
            : (rawMax - rawMin) * .08;
        _minY = rawMin - padding;
        _maxY = rawMax + padding;
        _hitRegions = BuildHitRegions();
        _needsDragInitialization = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_needsDragInitialization || Series.Count == 0)
        {
            return;
        }

        _needsDragInitialization = false;
        _module ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./Components/HistoryChart.razor.js");
        if (_dragHandle is not null)
        {
            await _dragHandle.InvokeVoidAsync("dispose");
            await _dragHandle.DisposeAsync();
        }

        _selfReference ??= DotNetObjectReference.Create(this);
        _dragHandle = await _module.InvokeAsync<IJSObjectReference>(
            "initializeRangeDrag",
            _chartElement,
            _selfReference,
            PlotLeft,
            PlotWidth);
    }

    [JSInvokable]
    public async Task CompleteRangeDrag(double startRatio, double endRatio)
    {
        var start = Math.Clamp(Math.Min(startRatio, endRatio), 0, 1);
        var end = Math.Clamp(Math.Max(startRatio, endRatio), 0, 1);
        if (end - start < .005)
        {
            return;
        }

        var startTicks = MinTicks + (long)((MaxTicks - MinTicks) * start);
        var endTicks = MinTicks + (long)((MaxTicks - MinTicks) * end);
        await ChangeRangeAsync(HistoryTimeRange.Custom(
            new DateTime(startTicks, DateTimeKind.Unspecified),
            new DateTime(endTicks, DateTimeKind.Unspecified)));
    }

    private IReadOnlyList<ChartSeries> BuildSeries()
    {
        if (!Normalized)
        {
            return _visibleHistories
                .Select(history => new ChartSeries(
                    history,
                    history.Observations
                        .Select(observation => new ChartPoint(
                            observation.Timestamp,
                            observation.Value))
                        .ToArray()))
                .Where(series => series.Points.Count > 0)
                .ToArray();
        }

        if (_visibleHistories.Count == 0)
        {
            return [];
        }

        var baselineId = _visibleHistories[0].Run.Id;
        return _visibleHistories
            .Select(history => new ChartSeries(
                history,
                _visibleMatches
                    .Where(match => match.Observations[baselineId].Value != 0)
                    .Select(match =>
                    {
                        var observation = match.Observations[history.Run.Id];
                        var baseline = match.Observations[baselineId];
                        return new ChartPoint(
                            observation.Timestamp,
                            observation.Value / baseline.Value);
                    }).ToArray()))
            .Where(series => series.Points.Count > 0)
            .ToArray();
    }

    private long MinTicks => _minTicks;

    private long MaxTicks => _maxTicks;

    private double MinY => _minY;

    private double MaxY => _maxY;

    private bool IsVisible(DateTime timestamp) =>
        timestamp.Ticks >= MinTicks && timestamp.Ticks <= MaxTicks;

    private double ScaleX(long ticks) =>
        PlotLeft + (ticks - MinTicks) / (double)(MaxTicks - MinTicks) * PlotWidth;

    private double ScaleY(double value) =>
        PlotTop + (MaxY - value) / (MaxY - MinY) * PlotHeight;

    private string Polyline(IReadOnlyList<ChartPoint> points) =>
        string.Join(
            " ",
            points.Select(point => string.Create(
                CultureInfo.InvariantCulture,
                $"{ScaleX(point.Timestamp.Ticks):0.##},{ScaleY(point.Value):0.##}")));

    private static IEnumerable<ChartPoint> SamplePoints(IReadOnlyList<ChartPoint> points)
    {
        var step = Math.Max(1, (int)Math.Ceiling(points.Count / 100d));
        for (var index = 0; index < points.Count; index += step)
        {
            yield return points[index];
        }

        if (points.Count > 1 && (points.Count - 1) % step != 0)
        {
            yield return points[^1];
        }
    }

    private IReadOnlyList<HitRegion> BuildHitRegions()
    {
        if (_hoverIndex.Timestamps.Count == 0)
        {
            return [];
        }

        var centers = _hoverIndex.Timestamps
            .Select(timestamp => ScaleX(timestamp.Ticks))
            .ToArray();
        var regions = new HitRegion[centers.Length];
        for (var index = 0; index < centers.Length; index++)
        {
            var left = index == 0
                ? PlotLeft
                : (centers[index - 1] + centers[index]) / 2d;
            var right = index == centers.Length - 1
                ? PlotLeft + PlotWidth
                : (centers[index] + centers[index + 1]) / 2d;
            regions[index] = new HitRegion(index, left, Math.Max(.25, right - left));
        }

        return regions;
    }

    private void SelectTimeline(int timelineIndex) =>
        _hover = _hoverIndex.SelectAt(timelineIndex);

    private void OnScrubberFocus()
    {
        _hasKeyboardFocus = true;
        _hover ??= _hoverIndex.SelectAt(_hoverIndex.Timestamps.Count - 1);
    }

    private void OnScrubberBlur() => _hasKeyboardFocus = false;

    private void OnScrubberInput(ChangeEventArgs eventArgs)
    {
        if (_hoverIndex.Timestamps.Count == 0
            || !int.TryParse(
                eventArgs.Value?.ToString(),
                NumberStyles.Integer,
                CultureInfo.InvariantCulture,
                out var timelineIndex))
        {
            return;
        }

        _hover = _hoverIndex.SelectAt(timelineIndex);
    }

    private void ClearHover() => _hover = null;

    private async Task RequestPinAsync(
        InvestigationPinSlot slot,
        ChartHoverPoint point) =>
        await PinRequested.InvokeAsync(new InvestigationPinRequest(
            slot,
            new InvestigationPin(
                point.History.Run.Id,
                ObservationIdentity.From(point.Observation))));

    private async Task ChangeRangeAsync(HistoryTimeRange range)
    {
        _hover = null;
        await TimeRangeChanged.InvokeAsync(range);
    }

    private Task ResetRangeAsync() => ChangeRangeAsync(HistoryTimeRange.All);

    private string FormatAxisValue(double value) =>
        Normalized
            ? value.ToString("0.000×", CultureInfo.InvariantCulture)
            : value.ToString(Math.Abs(value) >= 100 ? "N0" : "0.###", CultureInfo.InvariantCulture);

    private static string FormatDate(long ticks) =>
        new DateTime(ticks, DateTimeKind.Unspecified).ToString("MMM d\nyyyy", CultureInfo.InvariantCulture);

    private static string ShortSha(string sha) => sha.Length <= 10 ? sha : sha[..10];

    private static string FormatValue(double value) =>
        value.ToString(Math.Abs(value) >= 100 ? "N2" : "0.####", CultureInfo.InvariantCulture);

    private static string FormatError(double? error) =>
        error is null ? string.Empty : $" ± {FormatValue(error.Value)}";

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_dragHandle is not null)
            {
                await _dragHandle.InvokeVoidAsync("dispose");
                await _dragHandle.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        _selfReference?.Dispose();
    }

    private sealed record RangeOption(string Label, HistoryTimeRange Range);

    private sealed record ChartPoint(DateTime Timestamp, double Value);

    private sealed record HitRegion(int TimelineIndex, double X, double Width);

    private sealed record ChartSeries(
        BenchmarkHistory History,
        IReadOnlyList<ChartPoint> Points);

    private sealed record PinMarker(
        InvestigationPinSlot Slot,
        InvestigationPin Pin,
        string CssClass);
}
