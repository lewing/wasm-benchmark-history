@inherits LayoutComponentBase

<header class="site-header">
    <a class="brand" href="/">
        <span class="brand-mark">W</span>
        <span>
            <strong>Wasm benchmark history</strong>
            <small>.NET runtime comparison</small>
        </span>
    </a>
    <nav class="site-nav" aria-label="Primary">
        <a href="/">Benchmark explorer</a>
        <a href="/compare-builds">Compare builds</a>
        <a href="/change-set">Change set</a>
    </nav>
    <a class="source-link"
       href="https://github.com/dotnet/performance"
       target="_blank"
       rel="noopener noreferrer">dotnet/performance <span aria-hidden="true">↗</span></a>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
