@page "/"
@implements IDisposable
@inject BenchmarkHistoryService HistoryService
@inject NavigationManager Navigation

<PageTitle>WASM benchmark history</PageTitle>

<section class="hero">
    <p class="eyebrow">PUBLIC PERFORMANCE DATA</p>
    <h1>Compare .NET WASM performance across runtime modes.</h1>
    <p class="lede">
        Explore primary microbenchmark histories from <strong>dotnet/performance</strong>.
        Pages are fetched on demand and comparisons use exact build identities.
    </p>
</section>

@if (_catalog is null)
{
    <section class="loading-panel" aria-live="polite">
        <span class="spinner"></span>
        <div>
            <strong>Loading three benchmark indexes</strong>
            <p>History pages stay untouched until you choose a benchmark.</p>
        </div>
    </section>
}
else
{
    <section class="catalog-summary" aria-label="Catalog summary">
        <div><strong>@_catalogTotal.ToString("N0")</strong><span>unique benchmarks</span></div>
        <div><strong>@_sharedTotal.ToString("N0")</strong><span>shared by all runs</span></div>
        @foreach (var run in KnownRunConfigurations.All)
        {
            <div>
                <strong>@_runTotals[run.Id].ToString("N0")</strong>
                <span>@run.DisplayName</span>
            </div>
        }
    </section>

    <section class="control-panel">
        <div class="search-area">
            <label for="benchmark-search">1. Find a benchmark</label>
            <div class="search-box">
                <span aria-hidden="true">⌕</span>
                <input id="benchmark-search"
                       type="search"
                       value="@_searchText"
                       @oninput="OnSearchInput"
                       placeholder="Search by namespace, method, or parameter…"
                       autocomplete="off" />
            </div>

            @if (SearchResults.Count > 0)
            {
                <div class="search-results">
                    @foreach (var entry in SearchResults)
                    {
                        <button type="button" @onclick="() => SelectBenchmark(entry)">
                            <span class="result-name">@entry.Benchmark</span>
                            <span class="availability @(entry.IsShared ? "shared" : "partial")">
                                @(entry.IsShared ? "3/3 shared" : $"{entry.Pages.Count}/3 runs")
                            </span>
                        </button>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_searchText) && _selectedBenchmark is null)
            {
                <p class="empty-search">No benchmark in the loaded indexes matches this search.</p>
            }
        </div>

        <div class="run-area">
            <label>2. Choose 2–3 run configurations</label>
            <div class="run-options">
                @foreach (var run in KnownRunConfigurations.All)
                {
                    var available = _selectedBenchmark?.Pages.ContainsKey(run.Id) ?? false;
                    <label class="run-option @(available ? null : "unavailable")">
                        <input type="checkbox"
                               checked="@_selectedRunIds.Contains(run.Id)"
                               disabled="@(!available)"
                               @onchange="() => ToggleRun(run.Id)" />
                        <span class="series-swatch" style="background:@run.Color"></span>
                        <span>
                            <strong>@run.DisplayName</strong>
                            <small>@(available ? run.Description : "Not available for this benchmark")</small>
                        </span>
                    </label>
                }
            </div>
        </div>

        <div class="load-area">
            @if (_selectedBenchmark is not null)
            {
                <div class="selected-benchmark">
                    <span>Selected</span>
                    <strong>@_selectedBenchmark.Benchmark</strong>
                    <small class="@(_selectedBenchmark.IsShared ? "shared-text" : "partial-text")">
                        @_selectedBenchmark.Availability
                    </small>
                </div>
            }
            else
            {
                <p>Select a search result to configure the comparison.</p>
            }

            <button class="primary-button"
                    type="button"
                    disabled="@(!CanLoad)"
                    @onclick="LoadHistoriesFromUiAsync">
                @if (_isLoadingHistories)
                {
                    <span class="button-spinner"></span>
                    <span>Loading histories…</span>
                }
                else
                {
                    <span>Compare histories</span>
                    <span aria-hidden="true">→</span>
                }
            </button>
        </div>
    </section>
}

@if (_errorMessage is not null)
{
    <div class="error-banner" role="alert">
        <strong>Data could not be loaded.</strong>
        <span>@_errorMessage</span>
    </div>
}

@if (_stateMessage is not null)
{
    <div class="state-banner" role="status">
        <strong>Shared state was adjusted.</strong>
        <span>@_stateMessage</span>
    </div>
}

@if (_histories.Count > 0)
{
    <section class="results-heading">
        <div>
            <p class="eyebrow">PRIMARY TRACE HISTORY</p>
            <h2>@_histories[0].Benchmark</h2>
            <p>
                @_histories.Sum(history => history.Observations.Count).ToString("N0") observations
                across @_histories.Count run configurations
            </p>
        </div>
        <label class="mode-toggle">
            <input type="checkbox"
                   checked="@_normalized"
                   @onchange="OnNormalizedChanged" />
            <span>Normalize to @_histories[0].Run.DisplayName</span>
        </label>
    </section>

    <HistoryChart Histories="_histories"
                  Matches="_matches"
                  Normalized="_normalized"
                  TimeRange="_timeRange"
                  TimeRangeChanged="OnTimeRangeChanged"
                  BaselinePin="_baselinePin"
                  ComparisonPin="_comparisonPin"
                  PinRequested="OnPinRequested" />

    <RegressionInvestigationPanel Histories="_histories"
                                  InvestigationRunId="_investigationRunId"
                                  BaselinePin="_baselinePin"
                                  ComparisonPin="_comparisonPin"
                                  UseRobustSummary="_useRobustSummary"
                                  UseRobustSummaryChanged="OnRobustSummaryChanged"
                                  PinCleared="ClearPin"
                                  ClearAll="ClearInvestigation" />

    <section class="comparison-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">STRICT BUILD MATCHES</p>
                <h2>Point-by-point comparison</h2>
            </div>
            <span class="match-count">@_matches.Count.ToString("N0") matches</span>
        </div>
        <p class="match-rule">
            Rows appear only when <strong>timestamp + runtime SHA + performance repo SHA</strong>
            are identical in every selected run. Timestamp-only fallback is never used.
        </p>

        @if (_matches.Count == 0)
        {
            <div class="no-matches">
                <strong>No strict matches found.</strong>
                <p>The selected histories do not share observations from the exact same builds.</p>
            </div>
        }
        else
        {
            <div class="table-note">
                Showing @DisplayedMatches.Count.ToString("N0") most recent
                @if (_matches.Count > DisplayLimit)
                {
                    <span> of @_matches.Count.ToString("N0")</span>
                }
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Build identities</th>
                            @foreach (var history in _histories)
                            {
                                <th>
                                    <span class="header-swatch" style="background:@history.Run.Color"></span>
                                    @history.Run.DisplayName
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var match in DisplayedMatches)
                        {
                            var baseline = match.Observations[_histories[0].Run.Id];
                            <tr>
                                <td class="timestamp-cell">@match.Key.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="sha-cell">
                                    <span>runtime <code title="@match.Key.RuntimeSha">@ShortSha(match.Key.RuntimeSha)</code></span>
                                    <span>performance <code title="@match.Key.PerformanceSha">@ShortSha(match.Key.PerformanceSha)</code></span>
                                </td>
                                @foreach (var history in _histories)
                                {
                                    var observation = match.Observations[history.Run.Id];
                                    <td class="value-cell">
                                        <strong>@FormatValue(observation.Value)</strong>
                                        @if (observation.Error is not null)
                                        {
                                            <span> ± @FormatValue(observation.Error.Value)</span>
                                        }
                                        @if (baseline.Value == 0)
                                        {
                                            <small title="Ratio is undefined because the baseline is zero">—</small>
                                        }
                                        else
                                        {
                                            <small>@((observation.Value / baseline.Value).ToString("0.000×", CultureInfo.InvariantCulture))</small>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private const int DisplayLimit = 250;

    private BenchmarkCatalog? _catalog;
    private BenchmarkCatalogEntry? _selectedBenchmark;
    private string _searchText = string.Empty;
    private readonly HashSet<string> _selectedRunIds = new(StringComparer.Ordinal);
    private IReadOnlyList<BenchmarkHistory> _histories = [];
    private IReadOnlyList<MatchedComparison> _matches = [];
    private string? _errorMessage;
    private bool _isLoadingHistories;
    private bool _normalized;
    private HistoryTimeRange _timeRange = HistoryTimeRange.All;
    private string? _investigationRunId;
    private InvestigationPin? _baselinePin;
    private InvestigationPin? _comparisonPin;
    private bool _useRobustSummary;
    private string? _stateMessage;
    private long _loadVersion;
    private CancellationTokenSource? _loadCancellation;
    private int _catalogTotal;
    private int _sharedTotal;
    private bool _isInteractive;
    private string? _pendingCanonicalUri;
    private IReadOnlyDictionary<string, int> _runTotals =
        new Dictionary<string, int>(StringComparer.Ordinal);

    private IReadOnlyList<BenchmarkCatalogEntry> SearchResults =>
        _catalog is null || string.IsNullOrWhiteSpace(_searchText) || _selectedBenchmark is not null
            ? []
            : _catalog.Entries
                .Where(entry => entry.Benchmark.Contains(
                    _searchText.Trim(),
                    StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(entry => entry.IsShared)
                .ThenBy(entry => entry.Benchmark.Length)
                .Take(12)
                .ToArray();

    private bool CanLoad =>
        _selectedBenchmark is not null
        && _selectedRunIds.Count is >= 2 and <= 3
        && !_isLoadingHistories;

    private IReadOnlyList<MatchedComparison> DisplayedMatches =>
        _matches.TakeLast(DisplayLimit).Reverse().ToArray();

    protected override async Task OnInitializedAsync()
    {
        var sharedState = HistoryPageStateCodec.Parse(Navigation.Uri);
        if (sharedState.Warnings.Count > 0)
        {
            _stateMessage = string.Join(' ', sharedState.Warnings);
        }

        try
        {
            _catalog = await HistoryService.LoadCatalogAsync();
            _catalogTotal = _catalog.Entries.Count;
            _sharedTotal = _catalog.Entries.Count(entry => entry.IsShared);
            _runTotals = KnownRunConfigurations.All.ToDictionary(
                run => run.Id,
                run => _catalog.Entries.Count(entry => entry.Pages.ContainsKey(run.Id)),
                StringComparer.Ordinal);
            await RestoreSharedStateAsync(sharedState.State);
        }
        catch (BenchmarkDataException exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private void OnSearchInput(ChangeEventArgs eventArgs)
    {
        _searchText = eventArgs.Value?.ToString() ?? string.Empty;
        if (_selectedBenchmark is not null
            && !string.Equals(_searchText, _selectedBenchmark.Benchmark, StringComparison.Ordinal))
        {
            InvalidateCurrentLoad();
            _selectedBenchmark = null;
            _selectedRunIds.Clear();
            _histories = [];
            _matches = [];
            ClearInvestigationState();
            UpdateUrl();
        }
    }

    private void SelectBenchmark(BenchmarkCatalogEntry entry)
    {
        InvalidateCurrentLoad();
        _selectedBenchmark = entry;
        _searchText = entry.Benchmark;
        _selectedRunIds.Clear();
        foreach (var run in KnownRunConfigurations.All.Where(run => entry.Pages.ContainsKey(run.Id)))
        {
            _selectedRunIds.Add(run.Id);
        }

        _histories = [];
        _matches = [];
        _errorMessage = null;
        _normalized = false;
        _timeRange = HistoryTimeRange.All;
        ClearInvestigationState();
        UpdateUrl();
    }

    private void ToggleRun(string runId)
    {
        InvalidateCurrentLoad();
        if (!_selectedRunIds.Remove(runId))
        {
            _selectedRunIds.Add(runId);
        }

        _histories = [];
        _matches = [];
        if (_investigationRunId is not null && !_selectedRunIds.Contains(_investigationRunId))
        {
            ClearInvestigationState();
        }

        UpdateUrl();
    }

    private Task LoadHistoriesFromUiAsync() =>
        LoadHistoriesAsync(preserveViewState: false, updateUrl: true);

    private async Task LoadHistoriesAsync(bool preserveViewState, bool updateUrl)
    {
        if (_catalog is null || _selectedBenchmark is null || !CanLoad)
        {
            return;
        }

        InvalidateCurrentLoad();
        var loadVersion = _loadVersion;
        var loadCancellation = new CancellationTokenSource();
        _loadCancellation = loadCancellation;
        _isLoadingHistories = true;
        _errorMessage = null;
        _histories = [];
        _matches = [];
        if (!preserveViewState)
        {
            _normalized = false;
            _timeRange = HistoryTimeRange.All;
            ClearInvestigationState();
        }

        try
        {
            var orderedRunIds = KnownRunConfigurations.All
                .Where(run => _selectedRunIds.Contains(run.Id))
                .Select(run => run.Id)
                .ToArray();
            var histories = await HistoryService.LoadHistoriesAsync(
                _catalog,
                _selectedBenchmark.Benchmark,
                orderedRunIds,
                loadCancellation.Token);
            if (loadVersion != _loadVersion)
            {
                return;
            }

            _histories = histories;
            _matches = ObservationMatcher.MatchStrict(histories);
            NormalizeCustomTimeRange();
            if (updateUrl)
            {
                UpdateUrl();
            }
        }
        catch (OperationCanceledException) when (loadCancellation.IsCancellationRequested)
        {
        }
        catch (BenchmarkDataException exception)
        {
            if (loadVersion == _loadVersion)
            {
                _errorMessage = exception.Message;
            }
        }
        finally
        {
            if (ReferenceEquals(_loadCancellation, loadCancellation))
            {
                _loadCancellation = null;
                loadCancellation.Dispose();
                _isLoadingHistories = false;
            }
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _isInteractive = true;
        if (_pendingCanonicalUri is not null)
        {
            NavigateToCanonicalUri(_pendingCanonicalUri);
            _pendingCanonicalUri = null;
        }
    }

    private async Task RestoreSharedStateAsync(HistoryPageState state)
        {
            if (_catalog is null)
            {
                return;
            }

            if (state.Benchmark is null)
            {
                UpdateUrl();
                return;
            }

            var entry = _catalog.Find(state.Benchmark);
            if (entry is null)
            {
                AddStateMessage($"Benchmark '{state.Benchmark}' is not in the current catalog.");
                UpdateUrl();
                return;
            }

            _selectedBenchmark = entry;
            _searchText = entry.Benchmark;
            _selectedRunIds.Clear();
            var requestedRuns = state.RunIds.Count > 0
                ? KnownRunConfigurations.All.Where(run => state.RunIds.Contains(run.Id))
                : KnownRunConfigurations.All.Where(run => entry.Pages.ContainsKey(run.Id));
            foreach (var run in requestedRuns.Where(run => entry.Pages.ContainsKey(run.Id)))
            {
                _selectedRunIds.Add(run.Id);
            }

            if (_selectedRunIds.Count < 2)
            {
                AddStateMessage("The shared run selection is not available for this benchmark.");
                _selectedRunIds.Clear();
                foreach (var run in KnownRunConfigurations.All.Where(run => entry.Pages.ContainsKey(run.Id)))
                {
                    _selectedRunIds.Add(run.Id);
                }
            }

            if (_selectedRunIds.Count < 2)
            {
                AddStateMessage("This benchmark does not have enough available runs to restore a comparison.");
                return;
            }

            _normalized = state.Normalized;
            _timeRange = state.TimeRange;
            _useRobustSummary = state.UseRobustSummary;
            _investigationRunId = state.InvestigationRunId;
            if (_investigationRunId is not null && !_selectedRunIds.Contains(_investigationRunId))
            {
                AddStateMessage("The investigation run was not selected and was ignored.");
                _investigationRunId = null;
            }

            await LoadHistoriesAsync(preserveViewState: true, updateUrl: false);
            if (_histories.Count == 0 || _investigationRunId is null)
            {
                UpdateUrl();
                return;
            }

            var history = _histories.First(history => history.Run.Id == _investigationRunId);
            _baselinePin = RestorePin(history, state.BaselineA, "baseline A");
            _comparisonPin = RestorePin(history, state.ComparisonB, "comparison B");
            UpdateUrl();
        }

        private InvestigationPin? RestorePin(
            BenchmarkHistory history,
            ObservationIdentity? identity,
            string label)
        {
            if (identity is null)
            {
                return null;
            }

            var pin = new InvestigationPin(history.Run.Id, identity.Value);
            if (RegressionInvestigation.Resolve(history, pin) is not null)
            {
                return pin;
            }

            AddStateMessage($"The shared {label} pin is missing or ambiguous and was ignored.");
            return null;
        }

        private void OnNormalizedChanged(ChangeEventArgs eventArgs)
        {
            _normalized = eventArgs.Value is true;
            UpdateUrl();
        }

        private void OnTimeRangeChanged(HistoryTimeRange range)
        {
            _timeRange = range;
            UpdateUrl();
        }

        private void OnPinRequested(InvestigationPinRequest request)
        {
            if (!string.Equals(
                    _investigationRunId,
                    request.Pin.RunId,
                    StringComparison.Ordinal))
            {
                _investigationRunId = request.Pin.RunId;
                _baselinePin = null;
                _comparisonPin = null;
            }

            if (request.Slot == InvestigationPinSlot.BaselineA)
            {
                _baselinePin = request.Pin;
            }
            else
            {
                _comparisonPin = request.Pin;
            }

            UpdateUrl();
        }

        private void ClearPin(InvestigationPinSlot slot)
        {
            if (slot == InvestigationPinSlot.BaselineA)
            {
                _baselinePin = null;
            }
            else
            {
                _comparisonPin = null;
            }

            if (_baselinePin is null && _comparisonPin is null)
            {
                _investigationRunId = null;
            }

            UpdateUrl();
        }

        private void ClearInvestigation()
        {
            ClearInvestigationState();
            UpdateUrl();
        }

        private void OnRobustSummaryChanged(bool robust)
        {
            _useRobustSummary = robust;
            UpdateUrl();
        }

        private void ClearInvestigationState()
        {
            _investigationRunId = null;
            _baselinePin = null;
            _comparisonPin = null;
            _useRobustSummary = false;
        }

        private void AddStateMessage(string message) =>
            _stateMessage = string.IsNullOrWhiteSpace(_stateMessage)
                ? message
                : $"{_stateMessage} {message}";

        private void UpdateUrl()
        {
            var target = "/";
            if (_selectedBenchmark is not null)
            {
                var runIds = KnownRunConfigurations.All
                    .Where(run => _selectedRunIds.Contains(run.Id))
                    .Select(run => run.Id)
                    .ToArray();
                var state = new HistoryPageState(
                    _selectedBenchmark.Benchmark,
                    runIds,
                    _normalized,
                    _timeRange,
                    _investigationRunId,
                    _baselinePin?.Identity,
                    _comparisonPin?.Identity,
                    _useRobustSummary);
                target = HistoryPageStateCodec.ToRelativeUri(state);
            }

            if (!_isInteractive)
            {
                _pendingCanonicalUri = target;
                return;
            }

            NavigateToCanonicalUri(target);
        }

        private void NavigateToCanonicalUri(string target)
        {
            var absoluteTarget = Navigation.ToAbsoluteUri(target).AbsoluteUri;
            if (!string.Equals(absoluteTarget, Navigation.Uri, StringComparison.Ordinal))
            {
                Navigation.NavigateTo(target, replace: true);
            }
        }

        private void NormalizeCustomTimeRange()
        {
            if (_timeRange.Kind != HistoryRangeKind.Custom || _histories.Count == 0)
            {
                return;
            }

            var timestamps = _histories
                .SelectMany(history => history.Observations)
                .Select(observation => observation.Timestamp)
                .ToArray();
            if (timestamps.Length == 0)
            {
                _timeRange = HistoryTimeRange.All;
                AddStateMessage("The shared custom range was ignored because this history has no observations.");
                return;
            }

            var minimum = timestamps.Min();
            var maximum = timestamps.Max();
            var resolved = _timeRange.Resolve(minimum, maximum);
            if (resolved.Start == _timeRange.Start && resolved.End == _timeRange.End)
            {
                return;
            }

            _timeRange = resolved == (minimum, maximum)
                ? HistoryTimeRange.All
                : HistoryTimeRange.Custom(resolved.Start, resolved.End);
            AddStateMessage("The shared custom range was outside available history and was adjusted.");
        }

    private void InvalidateCurrentLoad()
    {
        _loadVersion++;
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = null;
        _isLoadingHistories = false;
    }

    public void Dispose() => InvalidateCurrentLoad();

    private static string ShortSha(string sha) =>
        sha.Length <= 8 ? sha : sha[..8];

    private static string FormatValue(double value) =>
        value.ToString(value >= 100 ? "N2" : "N4", CultureInfo.InvariantCulture);
}
