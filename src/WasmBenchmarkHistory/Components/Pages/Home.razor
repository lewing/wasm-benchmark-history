@page "/"
@implements IAsyncDisposable
@inject IBenchmarkHistoryOrchestrator HistoryService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Wasm benchmark history</PageTitle>

<section class="hero">
    <p class="eyebrow">PUBLISHED HISTORY + VERIFIED FALLBACKS</p>
    <h1>Compare .NET Wasm performance across runtime modes.</h1>
    <p class="lede">
        Explore primary microbenchmark histories from <strong>dotnet/performance</strong>.
        Pages are fetched on demand and comparisons use exact build identities.
    </p>
</section>

@if (_catalog is null)
{
    <section class="loading-panel" aria-live="polite">
        <span class="spinner"></span>
        <div>
            <strong>Loading published indexes and fallback snapshots</strong>
            <p>History pages stay untouched until you choose a benchmark.</p>
        </div>
    </section>
}
else
{
    <section class="catalog-summary" aria-label="Catalog summary">
        <div><strong>@_catalogTotal.ToString("N0")</strong><span>unique benchmarks</span></div>
        <div><strong>@_sharedTotal.ToString("N0")</strong><span>shared by all runs</span></div>
        @foreach (var run in KnownRunConfigurations.All)
        {
            <div>
                <strong>@_runTotals[run.Id].ToString("N0")</strong>
                <span>@run.DisplayName</span>
            </div>
        }
    </section>

    <section class="control-panel">
        <div class="search-area">
            <label for="benchmark-search">1. Find a benchmark</label>
            <div class="search-box">
                <span aria-hidden="true">⌕</span>
                <input id="benchmark-search"
                       type="search"
                       value="@_searchText"
                       @oninput="OnSearchInput"
                       placeholder="Search by namespace, method, or parameter…"
                       autocomplete="off" />
            </div>

            <div class="tree-heading">
                <span>@(HasTreeFilter ? "Matching categories" : "Browse by category")</span>
                <small>@TreeBenchmarkCount.ToString("N0") benchmarks</small>
            </div>

                <p id="benchmark-selection-help" class="tree-help">
                    Click to select. Cmd/Ctrl-click or use checkboxes to add; Shift-click selects a range.
                </p>
                <div @ref="_treeElement"
                     class="benchmark-tree"
                     role="tree"
                     tabindex="0"
                     aria-multiselectable="true"
                     aria-describedby="benchmark-selection-help"
                     aria-label="Microbenchmarks grouped by category"
                     data-item-count="@TreeItems.Count">
                    <Virtualize TItem="BenchmarkTreeItem" Items="TreeItems" Context="item" ItemSize="39">
                        @if (item.Entry is null)
                        {
                            @if (HasTreeFilter)
                            {
                                <div class="tree-category filtered"
                                     role="treeitem"
                                     aria-expanded="true"
                                     aria-level="@(item.Depth + 1)"
                                     tabindex="-1"
                                     data-tree-index="@item.Index"
                                     data-parent-index="@item.ParentIndex"
                                     style="--tree-depth:@item.Depth">
                                    <span class="tree-chevron" aria-hidden="true">⌄</span>
                                    <strong>@item.Label</strong>
                                    <small>@item.Count.ToString("N0")</small>
                                </div>
                            }
                            else
                            {
                                <button class="tree-category"
                                        type="button"
                                        role="treeitem"
                                        aria-expanded="@(IsCategoryExpanded(item.Path) ? "true" : "false")"
                                        aria-level="@(item.Depth + 1)"
                                        tabindex="-1"
                                        data-tree-index="@item.Index"
                                        data-parent-index="@item.ParentIndex"
                                        data-expandable="true"
                                        style="--tree-depth:@item.Depth"
                                        @onclick="() => ToggleCategory(item.Path)">
                                    <span class="tree-chevron" aria-hidden="true">
                                        @(IsCategoryExpanded(item.Path) ? "⌄" : "›")
                                    </span>
                                    <strong>@item.Label</strong>
                                    <small>@item.Count.ToString("N0")</small>
                                </button>
                            }
                        }
                        else
                        {
                            <div class="tree-benchmark @(_selection.Contains(item.Entry.Benchmark) ? "selected" : null)"
                                    role="treeitem"
                                    aria-selected="@(_selection.Contains(item.Entry.Benchmark) ? "true" : "false")"
                                    aria-level="@(item.Depth + 1)"
                                    aria-label="@item.Entry.Benchmark"
                                    tabindex="-1"
                                    data-tree-index="@item.Index"
                                    data-parent-index="@item.ParentIndex"
                                    title="@item.Entry.Benchmark"
                                    style="--tree-depth:@item.Depth"
                                    @onclick="args => SelectBenchmarkAsync(item.Entry, args)">
                                <input type="checkbox"
                                       tabindex="-1"
                                       checked="@_selection.Contains(item.Entry.Benchmark)"
                                       aria-label="@($"Select {item.Entry.Benchmark}")"
                                       @onclick:stopPropagation="true"
                                       @onclick="args => SelectBenchmarkAsync(item.Entry, args, toggle: true)" />
                                <span class="result-name">@GetBenchmarkLabel(item)</span>
                                <span class="availability @(item.Entry.IsShared ? "shared" : "partial")">
                                    @($"{item.Entry.AvailableRunCount}/{item.Entry.ExpectedRunCount}")
                                </span>
                            </div>
                        }
                    </Virtualize>
                    @if (TreeItems.Count == 0)
                    {
                        <p class="empty-search">No benchmark in the loaded indexes matches this search.</p>
                    }
                </div>
        </div>

        <div class="run-area">
            <span class="step-label" id="run-step-label">2. Choose 2–@KnownRunConfigurations.All.Count run configurations</span>
            <p class="run-hint">Click a run to cycle off → shown → focused. Focused runs stay bright; other shown runs fade.</p>
            <RunVisibilityToggles State="_runVisibility"
                                  IsAvailable="IsRunAvailable"
                                  Describe="DescribeRun"
                                  OnCycle="CycleRunAsync"
                                  OnClearFocus="ClearRunFocus" />
        </div>

        <div class="load-area">
            @if (_selection.Selected.Count > 0)
            {
                <div class="selected-benchmark">
                    <span>@_selection.Selected.Count selected · stacked graphs</span>
                    <ul class="selected-benchmarks">
                        @foreach (var benchmark in _selection.Selected)
                        {
                            <li @key="benchmark">
                                <button type="button"
                                        class="selection-name"
                                        aria-pressed="@(benchmark == _selection.ActiveBenchmark ? "true" : "false")"
                                        @onclick="() => ActivateBenchmark(benchmark)">@benchmark</button>
                                <button type="button"
                                        class="remove-benchmark"
                                        aria-label="@($"Remove {benchmark}")"
                                        @onclick="() => RemoveBenchmarkAsync(benchmark)">×</button>
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <p>Select a benchmark to compare its available run configurations.</p>
            }

            <div class="history-load-status" role="status" aria-live="polite">
                @if (_isLoadingHistories)
                {
                    <span class="history-spinner" aria-hidden="true"></span>
                    <span>Loading histories…</span>
                }
                else if (_selection.Selected.Count > 0 && _selectedRunIds.Count < 2)
                {
                    <span>Select at least two run configurations to compare.</span>
                }
            </div>
        </div>
    </section>
}

@if (_errorMessage is not null)
{
    <div class="error-banner" role="alert">
        <strong>Data could not be loaded.</strong>
        <span>@_errorMessage</span>
    </div>
}

@if (_stateMessage is not null)
{
    <div class="state-banner" role="status">
        <strong>Shared state was adjusted.</strong>
        <span>@_stateMessage</span>
    </div>
}

@if (_selection.Selected.Count > 0 && _selectedRunIds.Count >= 2)
{
    var compact = _selection.Selected.Count > 1;
    var lastBenchmark = _selection.Selected[^1];
    <div class="stack-toolbar">
        <HistoryChartToolbar TimeRange="_timeRange"
                             TimeRangeChanged="OnTimeRangeChanged"
                             ShowVariabilityBand="_showVariabilityBand"
                             ShowVariabilityBandChanged="OnVariabilityBandChanged"
                             VariabilityWindow="_variabilityWindow"
                             VariabilityWindowChanged="OnVariabilityWindowChanged"
                             ShowPerformanceRevisionMarkers="_showPerformanceRevisionMarkers"
                             ShowPerformanceRevisionMarkersChanged="OnPerformanceRevisionMarkersChanged" />
        <div class="stack-legend">
            <RunVisibilityToggles State="_runVisibility"
                                  IsAvailable="IsRunAvailable"
                                  Legend="true"
                                  Label="Chart runs: click to cycle off, shown, focused"
                                  OnCycle="CycleRunAsync"
                                  OnClearFocus="ClearRunFocus" />
            <label class="mode-toggle">
                <input type="checkbox"
                       checked="@_normalized"
                       @onchange="OnNormalizedChanged" />
                <span>Normalize to first available run</span>
            </label>
        </div>
        @if (compact)
        {
            <p>Shared time axis, zoom and crosshair · independent value scales · select a row for investigation details.</p>
        }
    </div>
    <section class="chart-stack @(compact ? "compact" : null)" aria-label="Selected benchmark histories">
        @foreach (var benchmark in _selection.Selected)
        {
            var active = benchmark == _selection.ActiveBenchmark;
            <article @key="benchmark" class="benchmark-chart @(active ? "active-benchmark" : null)">
                <header class="results-heading @(compact ? "row-heading" : null)">
                    <div>
                        <h2 title="@benchmark">@benchmark</h2>
                        @if (_benchmarkResults.TryGetValue(benchmark, out var summary) && summary.Error is null)
                        {
                            <p>@summary.Histories.Sum(history => history.Observations.Count).ToString("N0") observations across @summary.Histories.Count run configurations</p>
                        }
                    </div>
                    <button class="activate-benchmark"
                            type="button"
                            aria-pressed="@(active ? "true" : "false")"
                            @onclick="() => ActivateBenchmark(benchmark)">
                        @(active ? "Active details" : "Show details")
                    </button>
                </header>
                @if (_benchmarkResults.TryGetValue(benchmark, out var result))
                {
                    @if (result.Error is not null)
                    {
                        <div class="error-banner" role="alert">
                            <span>@result.Error</span>
                            <button type="button" class="activate-benchmark" @onclick="() => RetryBenchmarkAsync(benchmark)">Retry</button>
                        </div>
                    }
                    else
                    {
                        var missingRuns = KnownRunConfigurations.All
                            .Where(run => _selectedRunIds.Contains(run.Id) && !_catalog!.Find(benchmark)!.IsAvailable(run.Id))
                            .Select(run => run.DisplayName).ToArray();
                        @if (missingRuns.Length > 0)
                        {
                            <p class="history-note">No data for selected runs: @string.Join(", ", missingRuns).</p>
                        }
                        @if (result.Histories.SelectMany(history => history.DataConflicts ?? []).Any())
                        {
                            <div class="error-banner" role="alert">Published/direct overlap conflict: @string.Join(' ', result.Histories.SelectMany(history => history.DataConflicts ?? []).Distinct(StringComparer.Ordinal))</div>
                        }
                        <HistoryChart Histories="result.Histories"
                                      Matches="result.Matches"
                                      Normalized="_normalized"
                                      TimelineBounds="_timelineBounds"
                                      TimeRange="_timeRange"
                                      TimeRangeChanged="OnTimeRangeChanged"
                                      ShowVariabilityBand="_showVariabilityBand"
                                      ShowPerformanceRevisionMarkers="_showPerformanceRevisionMarkers"
                                      VariabilityWindow="_variabilityWindow"
                                      FocusedRunIds="_runVisibility.FocusedRunIds"
                                      Compact="compact"
                                      ShowTimeAxis="@(!compact || benchmark == lastBenchmark)"
                                      BaselinePin="_investigation.BaselinePin"
                                      ComparisonPin="_investigation.ComparisonPin"
                                      PinRequested="request => OnBenchmarkPinRequested(benchmark, request)" />
                    }
                }
                else
                {
                    <p class="history-note" role="status">Loading histories for @benchmark…</p>
                }
            </article>
        }
    </section>
}

@if (_histories.Count > 0)
{
    <section class="active-details-heading" aria-label="Active benchmark">
        <h2>Investigation: @_selection.ActiveBenchmark</h2>
    </section>

    @if (DirectObservationCount > 0)
    {
        <div class="state-banner direct-source" role="status">
            <strong>Offline fallback observations.</strong>
            <span>@DirectObservationCount bundled Helix snapshot observation(s) from @DirectObservationRange
                fill gaps not present in published history.
                Exact equivalent published points take precedence; conflicts fail visibly. Diamonds remain discrete
                fallback observations, and dashed connectors are visual guides only.</span>
        </div>
    }

    @if (_selection.Selected.Count > 1 && _showVariabilityBand && ActiveResult is { Error: null })
    {
        <VariabilityAnalysisPanels Histories="_histories"
                                   Matches="_matches"
                                   Normalized="_normalized"
                                   TimeRange="_timeRange"
                                   TimelineBounds="_timelineBounds"
                                   Window="_variabilityWindow"
                                   PinnedTimestamp="@(_investigation.ComparisonPin?.Identity.Timestamp ?? _investigation.BaselinePin?.Identity.Timestamp)"
                                   FocusedRunIds="_runVisibility.FocusedRunIds" />
    }

    <RegressionInvestigationPanel Histories="_selectedHistories"
                                  Benchmarks="_selection.Selected"
                                  RunIds="@_selectedRunIds"
                                  BaselinePin="_investigation.BaselinePin"
                                  ComparisonPin="_investigation.ComparisonPin"
                                  UseRobustSummary="_useRobustSummary"
                                  UseRobustSummaryChanged="OnRobustSummaryChanged"
                                  PinCleared="ClearPin"
                                  ClearAll="ClearInvestigation" />

    <section class="comparison-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">STRICT BUILD MATCHES</p>
                <h2>Point-by-point comparison</h2>
            </div>
            <span class="match-count">@_matches.Count.ToString("N0") matches</span>
        </div>
        <p class="match-rule">
            Rows appear only when <strong>timestamp + runtime SHA + performance repo SHA</strong>
            are identical in every selected run. Timestamp-only fallback is never used.
        </p>

        @if (_matches.Count == 0)
        {
            <div class="no-matches">
                <strong>No strict matches found.</strong>
                <p>The selected histories do not share observations from the exact same builds.</p>
            </div>
        }
        else
        {
            <div class="table-note">
                Showing @DisplayedMatches.Count.ToString("N0") most recent
                @if (_matches.Count > DisplayLimit)
                {
                    <span> of @_matches.Count.ToString("N0")</span>
                }
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Build identities</th>
                            @foreach (var history in _histories)
                            {
                                <th>
                                    <span class="header-swatch" style="background:@history.Run.Color"></span>
                                    @history.Run.DisplayName
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var match in DisplayedMatches)
                        {
                            var baseline = match.Observations[_histories[0].Run.Id];
                            <tr>
                                <td class="timestamp-cell">@match.Key.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="sha-cell">
                                    <span>runtime <code title="@match.Key.RuntimeSha">@ShortSha(match.Key.RuntimeSha)</code></span>
                                    <span>performance <code title="@match.Key.PerformanceSha">@ShortSha(match.Key.PerformanceSha)</code></span>
                                </td>
                                @foreach (var history in _histories)
                                {
                                    var observation = match.Observations[history.Run.Id];
                                    var unit = DurationFormatter.SelectUnit(observation.Value);
                                    <td class="value-cell">
                                        <strong title="@DurationFormatter.FormatExactNanoseconds(observation.Value)"
                                                aria-label="@DurationFormatter.FormatExactNanoseconds(observation.Value)">
                                            @DurationFormatter.Format(observation.Value, unit)
                                        </strong>
                                        @if (observation.Error is not null)
                                        {
                                            <span title="@DurationFormatter.FormatExactNanoseconds(observation.Error)">
                                                ± @DurationFormatter.Format(observation.Error.Value, unit)
                                            </span>
                                        }
                                        @if (baseline.Value == 0)
                                        {
                                            <small title="Ratio is undefined because the baseline is zero">—</small>
                                        }
                                        else
                                        {
                                            <small>@((observation.Value / baseline.Value).ToString("0.000×", CultureInfo.InvariantCulture))</small>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private const int DisplayLimit = 250;

    private BenchmarkCatalog? _catalog;
    private readonly BenchmarkSelectionState _selection = new();
    private readonly Dictionary<string, BenchmarkResult> _benchmarkResults = new(StringComparer.Ordinal);
    private BenchmarkResult? ActiveResult =>
        _selection.ActiveBenchmark is not null
        && _benchmarkResults.TryGetValue(_selection.ActiveBenchmark, out var result) ? result : null;
    private string _searchText = string.Empty;
    private readonly RunVisibilityState _runVisibility = new();
    private IReadOnlySet<string> _selectedRunIds => _runVisibility.ShownRunIds;
    private IReadOnlyList<BenchmarkHistory> _histories => ActiveResult?.Histories ?? [];
    private IReadOnlyList<BenchmarkHistory> _selectedHistories => _selection.Selected
        .Where(_benchmarkResults.ContainsKey)
        .SelectMany(benchmark => _benchmarkResults[benchmark].Histories)
        .ToArray();
    private IReadOnlyList<MatchedComparison> _matches => ActiveResult?.Matches ?? [];
    private string? _errorMessage;
    private bool _isLoadingHistories;
    private bool _normalized;
    private HistoryTimeRange _timeRange = HistoryTimeRange.All;
    private bool _showVariabilityBand;
    private bool _showPerformanceRevisionMarkers;
    private int _variabilityWindow = RollingVariabilityCalculator.DefaultWindow;
    private readonly InvestigationWorkflowState _investigation = new();
    private bool _useRobustSummary;
    private string? _stateMessage;
    private long _loadVersion;
    private CancellationTokenSource? _loadCancellation;
    private readonly SemaphoreSlim _historyConcurrency = new(3);
    private int _pendingHistoryLoads;
    private bool _disposed;
    private (DateTime Start, DateTime End)? _timelineBounds;
    private ElementReference _treeElement;
    private IJSObjectReference? _treeModule;
    private IJSObjectReference? _treeHandle;
    private List<BenchmarkTreeItem>? _treeItems;
    private readonly HashSet<string> _expandedCategories = new(StringComparer.OrdinalIgnoreCase);
    private int _catalogTotal;
    private int _sharedTotal;
    private bool _isInteractive;
    private string? _pendingCanonicalUri;
    private IReadOnlyDictionary<string, int> _runTotals =
        new Dictionary<string, int>(StringComparer.Ordinal);

    private bool HasTreeFilter => !string.IsNullOrWhiteSpace(_searchText);

    private List<BenchmarkTreeItem> TreeItems
    {
        get
        {
            if (_treeItems is not null)
            {
                return _treeItems;
            }

            if (_catalog is null)
            {
                return [];
            }

            var filter = _searchText.Trim();
            var items = new List<BenchmarkTreeItem>();
            foreach (var node in _catalog.CategoryTree)
            {
                AppendTreeItems(node, items, filter, ancestorMatches: false, depth: 0);
            }

            var parents = new Stack<BenchmarkTreeItem>();
            for (var index = 0; index < items.Count; index++)
            {
                var item = items[index];
                item.Index = index;
                while (parents.TryPeek(out var parent) && parent.Depth >= item.Depth)
                {
                    parents.Pop();
                }
                item.ParentIndex = parents.TryPeek(out var ancestor) ? ancestor.Index : -1;
                if (item.Entry is null)
                {
                    parents.Push(item);
                }
            }
            return _treeItems = items;
        }
    }

    private int TreeBenchmarkCount =>
        !HasTreeFilter
            ? _catalogTotal
            : TreeItems.Count(item => item.Entry is not null);

    private bool CanLoad =>
        _selection.Selected.Count > 0
        && _selectedRunIds.Count >= 2
        && _selectedRunIds.Count <= KnownRunConfigurations.All.Count;

    private bool IsRunAvailable(string runId) =>
        _selection.Selected.Count == 0
            ? _catalog?.ActiveRuns.Any(run => run.Id == runId) == true
            : _selection.Selected.Any(benchmark => _catalog!.Find(benchmark)!.IsAvailable(runId));

    private int DirectObservationCount => _histories.Sum(history =>
        history.Observations.Count(observation => observation.Source == ObservationSource.DirectSnapshot));
    private string DirectObservationRange
    {
        get
        {
            var timestamps = _histories.SelectMany(history => history.Observations)
                .Where(observation => observation.Source == ObservationSource.DirectSnapshot)
                .Select(observation => observation.Timestamp).ToArray();
            return timestamps.Length == 0
                ? "no retained builds"
                : $"{timestamps.Min():yyyy-MM-dd} through {timestamps.Max():yyyy-MM-dd}";
        }
    }
    private IReadOnlyList<MatchedComparison> DisplayedMatches =>
        _matches.TakeLast(DisplayLimit).Reverse().ToArray();

    protected override async Task OnInitializedAsync()
    {
        var sharedState = HistoryPageStateCodec.Parse(Navigation.Uri);
        if (sharedState.Warnings.Count > 0)
        {
            _stateMessage = string.Join(' ', sharedState.Warnings);
        }

        try
        {
            _catalog = await HistoryService.LoadCatalogAsync();
            _catalogTotal = _catalog.Entries.Count;
            _sharedTotal = _catalog.Entries.Count(entry => entry.IsShared);
            _runTotals = KnownRunConfigurations.All.ToDictionary(
                run => run.Id,
                run => _catalog.Entries.Count(entry => entry.IsAvailable(run.Id)),
                StringComparer.Ordinal);
            _runVisibility.Reset(_catalog.ActiveRuns.Select(run => run.Id));
            await RestoreSharedStateAsync(sharedState.State);
        }
        catch (BenchmarkDataException exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private void OnSearchInput(ChangeEventArgs eventArgs)
    {
        _searchText = eventArgs.Value?.ToString() ?? string.Empty;
        _treeItems = null;
    }

    private async Task SelectBenchmarkAsync(
        BenchmarkCatalogEntry entry, MouseEventArgs args, bool toggle = false)
    {
        var previousActive = _selection.ActiveBenchmark;
        _selection.Select(
            entry.Benchmark,
            TreeItems.Where(item => item.Entry is not null).Select(item => item.Entry!.Benchmark).ToArray(),
            toggle || args.CtrlKey || args.MetaKey,
            args.ShiftKey);
        if (previousActive != _selection.ActiveBenchmark)
        {
            ClearInvestigationState();
        }

        _errorMessage = null;
        UpdateUrl();
        await LoadHistoriesAsync(updateUrl: true);
    }

    private async Task RemoveBenchmarkAsync(string benchmark)
    {
        var previousActive = _selection.ActiveBenchmark;
        _selection.Select(benchmark, [], toggle: true);
        if (previousActive is not null && _selection.Contains(previousActive))
        {
            _selection.Activate(previousActive);
        }
        else
        {
            ClearInvestigationState();
        }
        UpdateUrl();
        await LoadHistoriesAsync(updateUrl: true);
    }

    private void ActivateBenchmark(string benchmark)
    {
        if (_selection.ActiveBenchmark != benchmark)
        {
            ClearInvestigationState();
            _selection.Activate(benchmark);
            UpdateUrl();
        }
    }

    private async Task RetryBenchmarkAsync(string benchmark)
    {
        _benchmarkResults.Remove(benchmark);
        await LoadHistoriesAsync(updateUrl: true);
    }

    private async Task CycleRunAsync(string runId)
    {
        if (_runVisibility.Cycle(runId) == RunVisibility.Focused)
        {
            // Focus only changes emphasis; the loaded histories remain valid.
            UpdateUrl();
            return;
        }

        _benchmarkResults.Clear();
        _timelineBounds = null;
        _errorMessage = null;
        ClearInvestigationState();

        UpdateUrl();
        await LoadHistoriesAsync(updateUrl: true);
    }

    private void ToggleCategory(string category)
    {
        _treeItems = null;
        if (!_expandedCategories.Remove(category))
        {
            _expandedCategories.Add(category);
        }
    }

    private bool IsCategoryExpanded(string category) =>
        _expandedCategories.Contains(category);

    private bool AppendTreeItems(
        BenchmarkCatalogNode node,
        List<BenchmarkTreeItem> items,
        string filter,
        bool ancestorMatches,
        int depth)
    {
        if (filter.Length == 0)
        {
            items.Add(new BenchmarkTreeItem(node, depth));
            if (!_expandedCategories.Contains(node.Path))
            {
                return true;
            }

            foreach (var child in node.Children)
            {
                AppendTreeItems(
                    child,
                    items,
                    filter,
                    ancestorMatches: false,
                    depth: depth + 1);
            }

            items.AddRange(node.Entries.Select(entry => new BenchmarkTreeItem(node, entry, depth)));
            return true;
        }

        var nodeMatches = ancestorMatches
            || node.Path.Contains(filter, StringComparison.OrdinalIgnoreCase);
        var descendants = new List<BenchmarkTreeItem>();
        foreach (var child in node.Children)
        {
            AppendTreeItems(
                child,
                descendants,
                filter,
                ancestorMatches: nodeMatches,
                depth: depth + 1);
        }

        var entries = nodeMatches
            ? node.Entries
            : node.Entries
                .Where(entry => entry.Benchmark.Contains(
                    filter,
                    StringComparison.OrdinalIgnoreCase))
                .ToArray();
        descendants.AddRange(entries.Select(entry => new BenchmarkTreeItem(node, entry, depth)));

        if (descendants.Count == 0)
        {
            return false;
        }

        items.Add(new BenchmarkTreeItem(node, depth, CountBenchmarks(descendants)));
        items.AddRange(descendants);
        return true;
    }

    private static int CountBenchmarks(IEnumerable<BenchmarkTreeItem> items) =>
        items.Count(item => item.Entry is not null);

    private async Task LoadHistoriesAsync(bool updateUrl)
    {
        InvalidateCurrentLoad();
        foreach (var benchmark in _benchmarkResults.Keys.Where(name => !_selection.Contains(name)).ToArray())
        {
            _benchmarkResults.Remove(benchmark);
        }
        UpdateTimelineBounds();
        var catalog = _catalog;
        if (catalog is null || !CanLoad)
        {
            return;
        }

        var loadVersion = _loadVersion;
        var loadCancellation = new CancellationTokenSource();
        var loadToken = loadCancellation.Token;
        _loadCancellation = loadCancellation;
        _pendingHistoryLoads++;
        _isLoadingHistories = true;
        _errorMessage = null;
        try
        {
            var orderedRunIds = KnownRunConfigurations.All
                .Where(run => _selectedRunIds.Contains(run.Id))
                .Select(run => run.Id)
                .ToArray();
            var pending = _selection.Selected.Where(name => !_benchmarkResults.ContainsKey(name)).ToArray();
            await Task.WhenAll(pending.Select(async benchmark =>
            {
                await _historyConcurrency.WaitAsync(loadToken);
                try
                {
                    loadToken.ThrowIfCancellationRequested();
                    BenchmarkResult result;
                    var runIds = orderedRunIds.Where(id => catalog.Find(benchmark)!.IsAvailable(id)).ToArray();
                    if (runIds.Length == 0)
                    {
                        result = new([], [], "This benchmark has no data for the selected run configurations.");
                    }
                    else
                    {
                        var histories = await HistoryService.LoadHistoriesAsync(
                            catalog, benchmark, runIds, loadToken);
                        result = new(histories, ObservationMatcher.MatchStrict(histories), null);
                    }
                    if (loadVersion == _loadVersion)
                    {
                        _benchmarkResults[benchmark] = result;
                        UpdateTimelineBounds();
                        StateHasChanged();
                    }
                }
                catch (BenchmarkDataException exception)
                {
                    if (loadVersion == _loadVersion)
                    {
                        _benchmarkResults[benchmark] = new([], [], exception.Message);
                        StateHasChanged();
                    }
                }
                finally
                {
                    _historyConcurrency.Release();
                }
            }));
            if (loadVersion != _loadVersion)
            {
                return;
            }

            NormalizeCustomTimeRange();
            if (updateUrl)
            {
                UpdateUrl();
            }
        }
        catch (OperationCanceledException) when (loadCancellation.IsCancellationRequested)
        {
        }
        catch (BenchmarkDataException exception)
        {
            if (loadVersion == _loadVersion)
            {
                _errorMessage = exception.Message;
            }
        }
        finally
        {
            _pendingHistoryLoads--;
            if (_disposed && _pendingHistoryLoads == 0)
            {
                _historyConcurrency.Dispose();
            }
            if (ReferenceEquals(_loadCancellation, loadCancellation))
            {
                _loadCancellation = null;
                loadCancellation.Dispose();
                _isLoadingHistories = false;
            }
        }
    }

    private void UpdateTimelineBounds()
    {
        var timestamps = _benchmarkResults.Values.SelectMany(result => result.Histories)
            .SelectMany(history => history.Observations).Select(observation => observation.Timestamp).ToArray();
        _timelineBounds = timestamps.Length == 0 ? null : (timestamps.Min(), timestamps.Max());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isInteractive = true;
            if (_pendingCanonicalUri is not null)
            {
                NavigateToCanonicalUri(_pendingCanonicalUri);
                _pendingCanonicalUri = null;
            }
        }
        if (_catalog is not null && _treeModule is null)
        {
            _treeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./benchmark-tree.js");
            _treeHandle = await _treeModule.InvokeAsync<IJSObjectReference>("initializeTree", _treeElement);
        }
    }

    private async Task RestoreSharedStateAsync(HistoryPageState state)
        {
            if (_catalog is null)
            {
                return;
            }

            var requestedBenchmarks = state.SelectedBenchmarks
                ?? (state.Benchmark is null ? [] : new[] { state.Benchmark });
            if (requestedBenchmarks.Count == 0)
            {
                UpdateUrl();
                return;
            }

            var selected = new List<string>();
            foreach (var benchmark in requestedBenchmarks)
            {
                if (_catalog.Find(benchmark) is null)
                {
                    AddStateMessage($"Benchmark '{benchmark}' is not in the current catalog.");
                }
                else
                {
                    selected.Add(benchmark);
                }
            }

            _selection.Restore(selected, state.Benchmark);
            ExpandSelectedCategories(_catalog.CategoryTree);
            _treeItems = null;
            var requestedRuns = state.RunIds.Count > 0
                ? KnownRunConfigurations.All.Where(run => state.RunIds.Contains(run.Id))
                : _catalog.ActiveRuns;
            _runVisibility.Reset(
                requestedRuns.Where(run => IsRunAvailable(run.Id)).Select(run => run.Id),
                state.FocusedRunIds);

            if (_selectedRunIds.Count < 2)
            {
                AddStateMessage("The shared run selection is not available for this benchmark.");
                _runVisibility.Reset(
                    KnownRunConfigurations.All.Where(run => IsRunAvailable(run.Id)).Select(run => run.Id),
                    state.FocusedRunIds);
            }

            if (_selectedRunIds.Count < 2)
            {
                AddStateMessage("The selected benchmarks do not have enough available runs to restore a comparison.");
                UpdateUrl();
                return;
            }

            _normalized = state.Normalized;
            _timeRange = state.TimeRange;
            _showVariabilityBand = state.ShowVariabilityBand;
            _variabilityWindow = state.VariabilityWindow;
            _useRobustSummary = state.UseRobustSummary;
            await LoadHistoriesAsync(updateUrl: false);
            _investigation.Restore(
                RestorePin(
                    state.BaselineRunId ?? state.InvestigationRunId,
                    state.BaselineA,
                    "baseline A"),
                RestorePin(
                    state.ComparisonRunId ?? state.InvestigationRunId,
                    state.ComparisonB,
                    "comparison B"));
            UpdateUrl();
        }

        private bool ExpandSelectedCategories(IEnumerable<BenchmarkCatalogNode> nodes)
        {
            var anySelected = false;
            foreach (var node in nodes)
            {
                var descendantSelected = ExpandSelectedCategories(node.Children);
                if (descendantSelected || node.Entries.Any(entry => _selection.Contains(entry.Benchmark)))
                {
                    _expandedCategories.Add(node.Path);
                    anySelected = true;
                }
            }
            return anySelected;
        }

        private InvestigationPin? RestorePin(
            string? runId,
            ObservationIdentity? identity,
            string label)
        {
            if (identity is null)
            {
                return null;
            }

            if (runId is null
                || !KnownRunConfigurations.All.Any(run => run.Id == runId))
            {
                AddStateMessage($"The shared {label} pin has no valid source runtime and was ignored.");
                return null;
            }

            return new InvestigationPin(runId, identity.Value);
        }

        private void OnNormalizedChanged(ChangeEventArgs eventArgs)
        {
            _normalized = eventArgs.Value is true;
            UpdateUrl();
        }

        private void OnPerformanceRevisionMarkersChanged(bool enabled) =>
            _showPerformanceRevisionMarkers = enabled;

        private void ClearRunFocus()
        {
            _runVisibility.ClearFocus();
            UpdateUrl();
        }

        private string DescribeRun(RunConfiguration run) =>
            IsRunAvailable(run.Id) ? run.Description
                : _catalog?.ActiveRuns.Contains(run) == false ? "No published results yet"
                : "Not available for the selected benchmarks";

        private void OnTimeRangeChanged(HistoryTimeRange range)
        {
            _timeRange = range;
            UpdateUrl();
        }

        private void OnVariabilityBandChanged(bool enabled)
        {
            _showVariabilityBand = enabled;
            UpdateUrl();
        }

        private void OnVariabilityWindowChanged(int window)
        {
            if (!RollingVariabilityCalculator.IsSupportedWindow(window))
            {
                return;
            }

            _variabilityWindow = window;
            UpdateUrl();
        }

        private void OnBenchmarkPinRequested(string benchmark, InvestigationPinRequest request)
        {
            ActivateBenchmark(benchmark);
            _investigation.Set(request);
            UpdateUrl();
        }

        private void ClearPin(InvestigationPinSlot slot)
        {
            _investigation.Clear(slot);
            UpdateUrl();
        }

        private void ClearInvestigation()
        {
            ClearInvestigationState();
            UpdateUrl();
        }

        private void OnRobustSummaryChanged(bool robust)
        {
            _useRobustSummary = robust;
            UpdateUrl();
        }

        private void ClearInvestigationState()
        {
            _investigation.Clear();
            _useRobustSummary = false;
        }

        private void AddStateMessage(string message) =>
            _stateMessage = string.IsNullOrWhiteSpace(_stateMessage)
                ? message
                : $"{_stateMessage} {message}";

        private void UpdateUrl()
        {
            var target = string.Empty;
            if (_selection.ActiveBenchmark is not null)
            {
                var runIds = KnownRunConfigurations.All
                    .Where(run => _selectedRunIds.Contains(run.Id))
                    .Select(run => run.Id)
                    .ToArray();
                var state = new HistoryPageState(
                    _selection.ActiveBenchmark,
                    runIds,
                    _normalized,
                    _timeRange,
                    _investigation.RunId,
                    _investigation.BaselinePin?.Identity,
                    _investigation.ComparisonPin?.Identity,
                    _useRobustSummary,
                    _showVariabilityBand,
                    _variabilityWindow,
                    _selection.Selected,
                    KnownRunConfigurations.All
                        .Where(run => _runVisibility.FocusedRunIds.Contains(run.Id))
                        .Select(run => run.Id)
                        .ToArray(),
                    _investigation.BaselinePin?.RunId,
                    _investigation.ComparisonPin?.RunId);
                target = HistoryPageStateCodec.ToRelativeUri(state).TrimStart('/');
            }

            if (!_isInteractive)
            {
                _pendingCanonicalUri = target;
                return;
            }

            NavigateToCanonicalUri(target);
        }

        private void NavigateToCanonicalUri(string target)
        {
            var absoluteTarget = Navigation.ToAbsoluteUri(target).AbsoluteUri;
            if (!string.Equals(absoluteTarget, Navigation.Uri, StringComparison.Ordinal))
            {
                Navigation.NavigateTo(target, replace: true);
            }
        }

        private void NormalizeCustomTimeRange()
        {
            if (_timeRange.Kind != HistoryRangeKind.Custom || _timelineBounds is null)
            {
                return;
            }

            var (minimum, maximum) = _timelineBounds.Value;
            var resolved = _timeRange.Resolve(minimum, maximum);
            if (resolved.Start == _timeRange.Start && resolved.End == _timeRange.End)
            {
                return;
            }

            _timeRange = resolved == (minimum, maximum)
                ? HistoryTimeRange.All
                : HistoryTimeRange.Custom(resolved.Start, resolved.End);
            AddStateMessage("The shared custom range was outside available history and was adjusted.");
        }

    private void InvalidateCurrentLoad()
    {
        _loadVersion++;
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = null;
        _isLoadingHistories = false;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        InvalidateCurrentLoad();
        if (_pendingHistoryLoads == 0)
        {
            _historyConcurrency.Dispose();
        }
        try
        {
            if (_treeHandle is not null)
            {
                await _treeHandle.InvokeVoidAsync("dispose");
                await _treeHandle.DisposeAsync();
            }
            if (_treeModule is not null)
            {
                await _treeModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private static string ShortSha(string sha) =>
        sha.Length <= 8 ? sha : sha[..8];

    private static string GetBenchmarkLabel(BenchmarkTreeItem item)
    {
        var benchmark = item.Entry!.Benchmark;
        var prefixLength = item.Path.Length + 1;
        return benchmark.Length > prefixLength
            && benchmark.StartsWith(item.Path, StringComparison.OrdinalIgnoreCase)
            && benchmark[item.Path.Length] == '.'
                ? benchmark[prefixLength..]
                : benchmark;
    }

    private sealed record BenchmarkTreeItem
    {
        public BenchmarkTreeItem(BenchmarkCatalogNode node, int depth, int? count = null)
        {
            Label = node.Name;
            Path = node.Path;
            Count = count ?? node.BenchmarkCount;
            Depth = depth;
        }

        public BenchmarkTreeItem(
            BenchmarkCatalogNode node,
            BenchmarkCatalogEntry entry,
            int depth)
        {
            Label = node.Name;
            Path = node.Path;
            Entry = entry;
            Depth = depth + 1;
        }

        public string Label { get; }

        public string Path { get; }

        public BenchmarkCatalogEntry? Entry { get; }

        public int Count { get; }

        public int Depth { get; }

        public int Index { get; set; }

        public int ParentIndex { get; set; }
    }

    private sealed record BenchmarkResult(
        IReadOnlyList<BenchmarkHistory> Histories,
        IReadOnlyList<MatchedComparison> Matches,
        string? Error);
}
